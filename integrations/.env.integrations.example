# Variables added by the advanced integrations (Evaluation Lab, voice, MCP server).
# Names and safe defaults only. Real values belong in your secret manager or your shell, never in git.
# Merge these by hand into the platform's own .env.example. This package never edits that file.

# ---- MCP server -------------------------------------------------------------------------------
# Required. At least 32 bytes. Create: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_TOKEN_PEPPER=
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp
MCP_STORE_PATH=data/mcp-clients.sqlite3
MCP_AUDIT_FILE=
MCP_POLICY_FILE=
MCP_LOG_LEVEL=info
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_MAX_BODY_BYTES=8388608
MCP_MAX_AUDIO_BYTES=5242880
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_RATE_LIMIT_GENERATE_PER_MINUTE=20
MCP_RATE_LIMIT_TRANSCRIBE_PER_MINUTE=10
MCP_RATE_LIMIT_EVALUATE_PER_MINUTE=3
MCP_RATE_LIMIT_PROJECT_PER_MINUTE=300
MCP_RATE_LIMIT_REQUESTS_PER_MINUTE=240
MCP_AUTH_FAILURES_PER_MINUTE=20
MCP_GENERATE_MAX_TOKENS=1024
MCP_EVALUATE_MAX_CASES=10
MCP_EVALUATE_MAX_ATTEMPTS=30
MCP_EVALUATE_MAX_SECONDS=90
MCP_EVALUATE_CALL_TIMEOUT_SECONDS=45
MCP_EVALUATE_MAX_CONCURRENT=2
MCP_TOOL_TIMEOUT_SECONDS=120
MCP_MAX_CONCURRENT_REQUESTS=200
MCP_BODY_READ_TIMEOUT_SECONDS=30
MCP_TOKEN_DEFAULT_TTL_DAYS=30
MCP_TOKEN_MAX_TTL_DAYS=90
# Optional adapters supplied by the platform, written package.module:function
MCP_GATEWAY_FACTORY=
MCP_USAGE_FACTORY=
MCP_PROJECTS_FACTORY=
MCP_RATE_LIMITER_FACTORY=
FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Voice (platform side) ---------------------------------------------------------------------
VOICE_MAX_UPLOAD_BYTES=10485760
VOICE_MAX_SECONDS=30
ASR_SERVICE_URL=
ASR_SERVICE_TOKEN=
ASR_ALLOWED_HOSTS=
ASR_TIMEOUT_SECONDS=60
# Local development only (worker on loopback, no TLS). Leave unset otherwise.
# ALLOW_PRIVATE_NETWORK_TARGETS=true
# ALLOW_INSECURE_HTTP_TARGETS=true

# ---- Evaluation Lab ----------------------------------------------------------------------------
EVAL_MAX_CASES=200
EVAL_MAX_CONCURRENCY=4
EVAL_CALL_TIMEOUT_SECONDS=90
EVAL_MAX_CONCURRENT_RUNS_PER_PROJECT=2
# Used only by examples/evaluation/run_dataset.py
# EVAL_GATEWAY_FACTORY=

# The ASR worker has its own list in asr-service/.env.example (HF_TOKEN, ASR_* settings).
