{
  "id": "starter-nigerian-languages",
  "name": "Starter: English, Hausa, Igbo and Yoruba phrases",
  "version": "1",
  "description": "Fifteen example cases for the four languages N-ATLaS lists: short everyday phrases in both directions, and a heuristic language check. Each case lists a few accepted answers. A fail means the output matched none of them, not that it is wrong, because correct phrasing varies. The language_match checks use a diacritics and word-list heuristic and often return review. Have a native speaker read the outputs before you draw any conclusion about quality, and add accepted forms they approve.",
  "cases": [
    {
      "id": "yo-good-morning-to-en",
      "name": "Yoruba greeting to English",
      "category": "language",
      "language": "yo",
      "prompt": "Translate this Yoruba greeting into English. Reply with only the translation: Ẹ kú àárọ̀",
      "max_tokens": 64,
      "checks": [
        {
          "type": "not_empty"
        },
        {
          "type": "contains_any",
          "values": [
            "good morning",
            "morning"
          ]
        }
      ],
      "tags": [
        "starter",
        "translation"
      ]
    },
