{
  "inputs": [
    {
      "type": "promptString",
      "id": "forge-mcp-token",
      "description": "Forge MCP token",
      "password": true
    }
  ],
  "servers": {
    "forge": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "headers": {
        "Authorization": "Bearer ${input:forge-mcp-token}"
      }
    }
  }
}
