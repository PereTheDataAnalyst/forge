# N-ATLAS ASR worker. Variable names only: put real values in your secret manager or your shell, never in git.
# Copy to .env.local (ignored by git) if you load variables from a file. The worker itself reads real environment variables.

# Required: a token the platform presents to the worker (24 or more characters).
ASR_SERVICE_TOKEN=
# Hugging Face token of an account that accepted each gated model's conditions. Read by the Hugging Face libraries.
HF_TOKEN=

ASR_HOST=127.0.0.1
ASR_PORT=8091
ASR_DEVICE=auto
ASR_PRELOAD_LANGUAGES=
ASR_MAX_UPLOAD_BYTES=10485760
ASR_MAX_SECONDS=30
ASR_MAX_CONCURRENCY=1
ASR_MAX_WAITING=8
ASR_DECODE_TIMEOUT_SECONDS=30
ASR_INFERENCE_TIMEOUT_SECONDS=120
# ASR_TEMP_DIR=
# FFMPEG_PATH=
# ASR_PROCESSOR_OVERRIDES=ha=owner/repository

# Development only, loopback host only. Leave unset otherwise.
# ASR_ALLOW_UNAUTHENTICATED_LOOPBACK=true
