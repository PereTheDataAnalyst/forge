{
  "name": "natlas-forge",
  "version": "0.1.0",
  "description": "Typed JavaScript and TypeScript client for N-ATLAS Forge, a hosted API for the N-ATLAS language model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/client.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "license": "UNLICENSED",
  "private": true
}
