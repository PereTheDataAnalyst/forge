# N-ATLAS Forge backend configuration for LOCAL DEVELOPMENT.
#
# scripts\setup-local.ps1 copies this file to .env and fills in generated secrets.
# Never commit .env. Production does not use a .env file: set these as real environment
# variables or secrets on the host. Never reuse development secrets in production.
#
# Values that are commented out show the default that applies when you leave them unset.

# --- Runtime -------------------------------------------------------------------------------
APP_ENV=development
# APP_NAME=N-ATLAS Forge
# DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO
# "console" is readable in a terminal, "json" suits log collectors.
LOG_FORMAT=console
# Serves Swagger UI at /api/docs. Keep false in production.
ENABLE_API_DOCS=true

# --- PostgreSQL ----------------------------------------------------------------------------
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://forge_app:CHANGE_ME@localhost:5432/forge_dev
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# Queries running longer than this are cancelled by PostgreSQL.
# DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (Memurai on Windows) ------------------------------------------------------------
# Used for rate limiting and login lockout counters only. It is never a primary store.
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# --- Secrets (at least 32 characters each) -------------------------------------------------
# Signs CSRF tokens.
SECRET_KEY=CHANGE_ME_run_scripts_setup_local_to_generate_a_value
# Keys the HMAC that protects stored API keys. Changing it invalidates every existing API key.
API_KEY_PEPPER=CHANGE_ME_run_scripts_setup_local_to_generate_a_value

# --- Sessions and cookies ------------------------------------------------------------------
# Must be true in production (HTTPS). Leave false for http://localhost.
COOKIE_SECURE=false
# SESSION_COOKIE_NAME=forge_session
# CSRF_COOKIE_NAME=forge_csrf
# Sign the user out after this long without activity.
# SESSION_IDLE_TTL_HOURS=72
# Sign the user out after this long regardless of activity.
# SESSION_ABSOLUTE_TTL_HOURS=336
# Set false to close sign-ups, for example for an invite-only period.
# REGISTRATION_ENABLED=true

# --- Network edge --------------------------------------------------------------------------
# The browser origin of the web app. Used for the Origin check on state-changing requests.
PUBLIC_BASE_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated. Wildcards are rejected.
# The Vite dev server proxies /api, so none are needed locally.
# CORS_ALLOWED_ORIGINS=
# Number of reverse proxies you trust in front of the API, used to read the client IP from
# X-Forwarded-For. Keep 0 unless a proxy you control sets that header.
# TRUSTED_PROXY_COUNT=0
# MAX_REQUEST_BODY_BYTES=1048576

# --- Rate limiting -------------------------------------------------------------------------
# Sign-in and registration attempts per client address per minute.
# AUTH_RATE_LIMIT_PER_MINUTE=20
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# Requests per API key per minute.
# GATEWAY_RATE_LIMIT_PER_MINUTE=60
# When Redis is down: false rejects requests (safer), true lets them through.
# RATE_LIMIT_FAIL_OPEN=false

# --- N-ATLAS inference worker --------------------------------------------------------------
# The official N-ATLAS release is open weights on Hugging Face and has no hosted API, so Forge
# talks to the worker in inference/natlas-worker. Leave URL and TOKEN unset until the worker
# runs. Both must be set together. scripts\connect-worker.ps1 fills them in for you.
# NATLAS_MODEL_ID=NCAIR1/N-ATLaS
# NATLAS_INFERENCE_URL=http://127.0.0.1:8081
# NATLAS_INFERENCE_TOKEN=
# In production the URL must use https unless the worker is on loopback. Set true only for a
# private network you control.
# NATLAS_ALLOW_PLAINTEXT_REMOTE=false
# NATLAS_CONNECT_TIMEOUT_SECONDS=3.0
# NATLAS_REQUEST_TIMEOUT_SECONDS=120.0
# NATLAS_HEALTH_CACHE_SECONDS=10.0
# NATLAS_DEFAULT_MAX_TOKENS=512
# NATLAS_MAX_TOKENS_LIMIT=2048
# NATLAS_MAX_MESSAGES=50
# NATLAS_MAX_INPUT_CHARS=32000
# The next three defaults mirror the example in the official model card.
# NATLAS_DEFAULT_TEMPERATURE=0.1
# NATLAS_DEFAULT_TOP_P=1.0
# NATLAS_DEFAULT_REPETITION_PENALTY=1.12

# --- Tests only (read by pytest, not by the application) -----------------------------------
# The test database name must contain "test" and the Redis logical database must be 10 or
# higher, because the suite flushes it. The suite refuses to run otherwise.
TEST_DATABASE_URL=postgresql+asyncpg://forge_app:CHANGE_ME@localhost:5432/forge_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15
