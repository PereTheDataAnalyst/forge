# N-ATLAS inference worker configuration. Copy to .env (never commit .env).

# Shared secret the Forge gateway sends as "Authorization: Bearer <token>". At least 32
# characters. The same value goes into NATLAS_INFERENCE_TOKEN in the gateway .env.
NATLAS_WORKER_TOKEN=CHANGE_ME_run_scripts_setup_local_to_generate

# Official model repository on Hugging Face (gated: accept the terms on the model page first).
NATLAS_WORKER_MODEL_ID=NCAIR1/N-ATLaS

# float16 | bfloat16 | float32 | auto. "auto" uses float16 on CUDA (as in the model card
# example) and bfloat16 on CPU.
NATLAS_WORKER_DTYPE=auto

# Prompt tokens plus requested new tokens must not exceed this value. 8092 is the context
# length published in the model card.
NATLAS_WORKER_CONTEXT_LIMIT_TOKENS=8092

# Generation is serialised by default because one model instance serves one request at a time.
NATLAS_WORKER_MAX_CONCURRENCY=1
NATLAS_WORKER_MAX_QUEUE=4
NATLAS_WORKER_MAX_GENERATION_SECONDS=120

# Hugging Face access token with read permission. Alternatively run "huggingface-cli login".
HF_TOKEN=
