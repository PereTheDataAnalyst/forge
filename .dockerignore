# Keeps the build context small and keeps secrets and local state out of the image.
.git
.github
.env
.env.*
**/.env
**/.env.*
**/node_modules
**/.venv
**/.venv-mcp
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/*.log
frontend/dist
backend/tests
docs
tools
scripts
sdk
inference
integrations/data
.forge-backups
.package
*.md
# The library's pyproject.toml names this file as its readme, so the install needs it.
!integrations/README.md
